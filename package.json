{
  "name": "hongguo-catalina",
  "version": "1.0.6",
  "macRelease": {
    "version": "1.0.6"
  },
  "description": "红果短剧播放与下载",
  "main": "main.js",
  "license": "GPL-3.0",
  "scripts": {
    "start": "npm_config_arch=x64 npm exec --cache .npm-cache --yes --package=electron@32.3.3 -- electron .",
    "dev": "node scripts/dev.js",
    "dev:react": "vite",
    "build:react": "vite build",
    "build": "npm run build:mac",
    "build:zip": "npm run build:react && electron-builder --win --x64 --publish never --dir && node scripts/make-zip.js",
    "build:dir": "npm run build:react && electron-builder --win --x64 --publish never --dir",
    "build:portable": "npm run build:react && electron-builder --win portable --x64 --publish never",
    "build:installer": "npm run build:react && electron-builder --win nsis --x64 --publish never",
    "pack": "npm run build:mac:dir",
    "zip": "node scripts/make-zip.js",
    "setup:ffmpeg:mac": "node scripts/setup-ffmpeg-mac.js x64",
    "build:mac": "npm run setup:ffmpeg:mac && npm run build:react && electron-builder --config build/electron-builder-mac.cjs --mac dmg --x64 --publish never",
    "build:mac:dir": "npm run setup:ffmpeg:mac && npm run build:react && electron-builder --config build/electron-builder-mac.cjs --mac --x64 --dir --publish never",
    "build:mac:test": "npm run build:mac:dir",
    "test": "node scripts/test.cjs",
    "setup:software": "node scripts/setup-software-player.cjs",
    "predev": "npm run setup:software",
    "prebuild:react": "npm run setup:software",
    "build:linux": "npm run build:react && node scripts/check-linux-media.cjs && electron-builder --linux AppImage --x64 --publish never"
  },
  "dependencies": {
    "anime4k-webgpu": "1.0.0",
    "axios": "1.20.0",
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "@libmedia/avplayer": "1.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^8.2.2",
    "electron-builder": "26.15.3",
    "esbuild": "0.21.5",
    "js-yaml": "4.3.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "semver": "7.7.4",
    "vite": "^5.4.11",
    "wait-on": "^7.2.0"
  },
  "overrides": {
    "shell-quote": "1.12.0",
    "joi": "17.13.8",
    "source-map-js": "1.2.2"
  },
  "build": {
    "appId": "io.github.yuangy1995.hongguo.catalina",
    "productName": "红果短剧 Catalina",
    "electronVersion": "32.3.3",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "dist-react/**/*",
      "src/native/**/*",
      "src/store.js"
    ],
    "asar": true,
    "artifactName": "hongguo-downloader-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "requestedExecutionLevel": "asInvoker",
      "extraResources": [
        {
          "from": "build/ffmpeg",
          "to": "bin",
          "filter": [
            "ffmpeg.exe",
            "ffprobe.exe",
            "librempeg.exe",
            "LIBREMPEG-*",
            "WINDOWS-*.txt",
            "COPYING.*",
            "LICENSE.md",
            "NV-*"
          ]
        }
      ],
      "extraFiles": [
        {
          "from": "LICENSE",
          "to": "LICENSE.txt"
        },
        {
          "from": "NOTICE",
          "to": "NOTICE.txt"
        },
        {
          "from": "THIRD-PARTY-NOTICES.md",
          "to": "THIRD-PARTY-NOTICES.md"
        }
      ]
    },
    "portable": {
      "artifactName": "${productName}-${version}-便携版.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "红果短剧下载器",
      "artifactName": "hongguo-downloader-${version}-win-x64-setup.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "public.app-category.video",
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "notarize": false,
      "minimumSystemVersion": "10.15.0",
      "extraResources": [
        {
          "from": "build/ffmpeg/darwin-${arch}",
          "to": "bin",
          "filter": [
            "ffmpeg",
            "ffprobe",
            "librempeg"
          ]
        },
        {
          "from": "build/ffmpeg",
          "to": "bin",
          "filter": [
            "COPYING.*",
            "LICENSE.md",
            "MACOS-*.txt",
            "LIBREMPEG-*"
          ]
        },
        {
          "from": "LICENSE",
          "to": "LICENSE.txt"
        },
        {
          "from": "NOTICE",
          "to": "NOTICE.txt"
        },
        {
          "from": "THIRD-PARTY-NOTICES.md",
          "to": "THIRD-PARTY-NOTICES.md"
        }
      ],
      "binaries": [
        "Contents/Resources/bin/ffmpeg",
        "Contents/Resources/bin/ffprobe",
        "Contents/Resources/bin/librempeg"
      ]
    },
    "publish": null,
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "AudioVideo",
      "icon": "build/icon.png",
      "executableName": "hongguo-drama",
      "extraResources": [
        {
          "from": "build/ffmpeg/linux-${arch}",
          "to": "bin",
          "filter": [
            "ffmpeg",
            "ffprobe",
            "librempeg",
            "COPYING.*",
            "LICENSE.md",
            "*-LICENSE.txt",
            "LIBREMPEG-*",
            "LINUX-*"
          ]
        },
        {
          "from": "LICENSE",
          "to": "LICENSE.txt"
        },
        {
          "from": "NOTICE",
          "to": "NOTICE.txt"
        },
        {
          "from": "THIRD-PARTY-NOTICES.md",
          "to": "THIRD-PARTY-NOTICES.md"
        }
      ],
      "syncDesktopName": true,
      "artifactName": "hongguo-downloader-${version}-linux-x64.${ext}",
      "extraFiles": [
        {
          "from": "build/linux-AppRun.sh",
          "to": "AppRun"
        }
      ]
    },
    "appImage": {
      "executableArgs": []
    },
    "buildVersion": "1.0.6"
  },
  "engines": {
    "node": ">=22.12"
  },
  "desktopName": "hongguo-drama.desktop",
  "updateFeed": {
    "provider": "github",
    "owner": "yuangy1995",
    "repo": "hongguo"
  }
}
